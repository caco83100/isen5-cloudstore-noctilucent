{
  "uid": "service-c-overview",
  "title": "Service C - Order (monitoring)",
  "tags": [
    "cloudstore",
    "service-c"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "1. SLO - est-ce que je tiens mes objectifs ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Disponibilité checkout (SLO 99,5 %)",
      "description": "% de POST /orders/checkout sans erreur 5xx (les 4xx = erreurs client, non comptées)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-c-order\", route=\"/orders/checkout\", status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-c-order\", route=\"/orders/checkout\"}[$__range]))"
        }
      ]
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Latence checkout < 500 ms (SLO 95 %)",
      "description": "% de checkouts répondus en moins de 500 ms",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"service-c-order\", route=\"/orders/checkout\", le=\"0.5\"}[$__range])) / sum(rate(http_request_duration_seconds_count{job=\"service-c-order\", route=\"/orders/checkout\"}[$__range]))"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Budget d'erreur restant",
      "description": "Part du 0,5 % d'échecs autorisés qui n'a pas encore été consommée",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - (sum(rate(http_requests_total{job=\"service-c-order\", route=\"/orders/checkout\", status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-c-order\", route=\"/orders/checkout\"}[$__range])))) / (1 - 0.995)"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Trafic total",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-c-order\"}[5m]))"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "2. RED - comment se comportent les requêtes ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate - requêtes par seconde (par route)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"service-c-order\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors - réponses non-2xx par seconde (par code)",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"service-c-order\", status_code!~\"2..\"}[1m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration - p95 de la latence",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-c-order\"}[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs (cliquer sur une ligne puis View trace in Jaeger)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"service-c-order\"} | line_format `{\"level\":\"{{.severity_text}}\",\"msg\":\"{{__line__}}\",\"order_id\":\"{{.order_id}}\",\"status_code\":\"{{.status_code}}\",\"reason\":\"{{.reason}}\",\"trace_id\":\"{{.trace_id}}\"}`"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Traces récentes (cliquer sur un Trace ID)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "service-c-order",
          "limit": 20
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "3. USE - est-ce que la machine tient ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 301,
      "type": "timeseries",
      "title": "CPU du processus",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (process_cpu_state) (process_cpu_utilization{job=\"service-c-order\"})",
          "legendFormat": "{{process_cpu_state}}"
        }
      ]
    },
    {
      "id": 302,
      "type": "timeseries",
      "title": "Mémoire du processus",
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_memory_usage{job=\"service-c-order\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 303,
      "type": "timeseries",
      "title": "Saturation : retard boucle d'événements (p99)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_delay_p99{job=\"service-c-order\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 304,
      "type": "timeseries",
      "title": "Utilisation de la boucle d'événements",
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_utilization{job=\"service-c-order\"}",
          "legendFormat": "utilization"
        }
      ]
    }
  ]
}