    {
      "id": 102,
      "type": "gauge",
      "title": "Latence p95 checkout",
      "description": "p95 de POST /orders/checkout (service C) sur 5 min. Vert < 500 ms (SLI du cours), orange 0,5-1 s, rouge > 1 s (seuil du SLO C2).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-c-order\", route=\"/orders/checkout\"}[5m])))"
        }
      ]
    },
