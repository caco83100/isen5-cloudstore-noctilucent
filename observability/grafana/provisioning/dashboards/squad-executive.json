        "x": 0,
        "y": 1,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Dashboard détaillé du service C",
          "url": "/d/service-c-overview"
        }
