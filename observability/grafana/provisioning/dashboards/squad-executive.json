            "properties": [
              {
                "id": "displayName",
                "value": "C1 · dispo ≥ 99,9 %"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
