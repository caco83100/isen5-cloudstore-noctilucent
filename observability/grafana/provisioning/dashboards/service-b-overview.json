{
  "uid": "service-b-overview",
  "title": "Service B - Catalog (monitoring)",
  "tags": [
    "cloudstore",
    "service-b"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "1. SLO - est-ce que je tiens mes objectifs ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "gauge",
      "title": "SLO 1 - Disponibilité réservation (objectif 99,9 %)",
      "description": "SLI = % de POST /inventory/reserve sans erreur 5xx sur la période. Les 409 (rupture de stock) et 400 (requête invalide) sont des refus métier normaux, non comptés comme pannes. B est sur le chemin critique du checkout : même cible que le SLO 1 de C.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.995
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "min": 0.99,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-b-catalog\", route=\"/inventory/reserve\", status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-b-catalog\", route=\"/inventory/reserve\"}[$__range]))"
        }
      ]
    },
    {
      "id": 102,
      "type": "gauge",
      "title": "SLO 2 - Latence réservation < 100 ms (objectif 95 %)",
      "description": "SLI = % de POST /inventory/reserve répondus en moins de 100 ms. B travaille en mémoire : 100 ms ne représente que 10 % du budget de 1 s du checkout (SLO 2 de C).",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "min": 0.8,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"service-b-catalog\", route=\"/inventory/reserve\", le=\"0.1\"}[$__range])) / sum(rate(http_request_duration_seconds_count{job=\"service-b-catalog\", route=\"/inventory/reserve\"}[$__range]))"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Budget d'erreur restant",
      "description": "Part du 0,1 % d'échecs (5xx) autorisés par le SLO 1 qui n'est pas encore consommée. Seuils de l'Error Budget Policy du cours : > 20 % vert, 0-20 % orange, < 0 % (budget épuisé) rouge.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - (sum(rate(http_requests_total{job=\"service-b-catalog\", route=\"/inventory/reserve\", status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-b-catalog\", route=\"/inventory/reserve\"}[$__range])))) / (1 - 0.999)"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Trafic réservation",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-b-catalog\", route=\"/inventory/reserve\"}[5m]))"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "2. RED - comment se comportent les requêtes ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate - requêtes par seconde (par route)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"service-b-catalog\", route=~\"/products|/inventory/.*\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors - % de réponses en erreur 4xx / 5xx (par code)",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"service-b-catalog\", status_code=~\"4..|5..\"}[1m])) / scalar(sum(rate(http_requests_total{job=\"service-b-catalog\", route=~\"/products|/inventory/.*\"}[1m])))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "description": "409 = rupture de stock (refus métier attendu, scénario Out-of-Stock). 400 = requête invalide. 5xx = panne de B (compte dans le SLO). Les 304 (cache navigateur sur /products) ne sont pas des erreurs."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration - p95 de la latence (par route)",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"service-b-catalog\", route=~\"/products|/inventory/.*\"}[1m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "description": "Ligne rouge = seuil du SLO 2 (100 ms)."
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs (cliquer sur une ligne puis View trace in Jaeger)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"service-b-catalog\"} | line_format `{\"level\":\"{{.severity_text}}\",\"msg\":\"{{__line__}}\",\"route\":\"{{.route}}\",\"status_code\":\"{{.status_code}}\",\"reason\":\"{{.reason}}\",\"product_id\":\"{{.product_id}}\",\"reservation_id\":\"{{.reservation_id}}\",\"trace_id\":\"{{.trace_id}}\"}`"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Traces des réservations (cliquer sur un Trace ID)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "service-b-catalog",
          "limit": 20,
          "operation": "POST /inventory/reserve"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "3. USE - est-ce que la machine tient ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 301,
      "type": "timeseries",
      "title": "CPU du processus",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (process_cpu_state) (process_cpu_utilization{job=\"service-b-catalog\"})",
          "legendFormat": "{{process_cpu_state}}"
        }
      ]
    },
    {
      "id": 302,
      "type": "timeseries",
      "title": "Mémoire du processus",
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_memory_usage{job=\"service-b-catalog\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 303,
      "type": "timeseries",
      "title": "Saturation : retard boucle d'événements (p99)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_delay_p99{job=\"service-b-catalog\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 304,
      "type": "timeseries",
      "title": "Utilisation de la boucle d'événements",
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_utilization{job=\"service-b-catalog\"}",
          "legendFormat": "utilization"
        }
      ]
    }
  ]
}
