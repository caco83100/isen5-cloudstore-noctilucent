{
  "uid": "service-d-overview",
  "title": "Service D - Payment (monitoring)",
  "tags": [
    "cloudstore",
    "service-d"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "1. SLO - est-ce que je tiens mes objectifs ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "gauge",
      "title": "SLO 1 - Disponibilité paiement (objectif 99,9 %)",
      "description": "SLI = % de POST /payments/charge sans erreur 5xx sur la période. Les 402 (paiement refusé par le prestataire simulé) et 400 (requête invalide) sont des refus métier normaux, non comptés comme pannes. Même cible que C et B (SLO 99,9 % / SLA 99,5 %, cf. cours).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.995
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "min": 0.99,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\", http_response_status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\"}[$__range]))"
        }
      ]
    },
    {
      "id": 102,
      "type": "gauge",
      "title": "SLO 2 - Latence paiement < 300 ms (objectif 99,5 %)",
      "description": "SLI = % de POST /payments/charge répondus en moins de 300 ms (SLO choisi par Malo, README de D). Avec la latence simulée à 800 ms (PAYMENT_LATENCY_MS), cette jauge passe au rouge.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "min": 0.95,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_bucket{job=\"service-d-payment\", http_route=\"/payments/charge\", le=\"0.3\"}[$__range])) / sum(rate(http_request_duration_count{job=\"service-d-payment\", http_route=\"/payments/charge\"}[$__range]))"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Budget d'erreur restant",
      "description": "Part du 0,1 % d'échecs (5xx) autorisés par le SLO 1 qui n'est pas encore consommée. Seuils de l'Error Budget Policy du cours : > 20 % vert, 0-20 % orange, < 0 % (budget épuisé) rouge.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - (sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\", http_response_status_code!~\"5..\"}[$__range])) / sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\"}[$__range])))) / (1 - 0.999)"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Trafic paiement",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\"}[5m]))"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "2. RED - comment se comportent les requêtes ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate - paiements par seconde (par code)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\"}[1m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors - % de réponses en erreur 4xx / 5xx (par code)",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_requests_total{job=\"service-d-payment\", http_response_status_code=~\"4..|5..\"}[1m])) / scalar(sum(rate(http_requests_total{job=\"service-d-payment\", http_route=\"/payments/charge\"}[1m])))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "description": "402 = paiement refusé (refus métier, PAYMENT_DECLINE_RATE). 400 = requête invalide. 5xx = panne de D (compte dans le SLO)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration - p95 de la latence (paiement)",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_bucket{job=\"service-d-payment\", http_route=\"/payments/charge\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "description": "Ligne rouge = seuil du SLO 2 (300 ms)."
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs (cliquer sur une ligne puis View trace in Jaeger)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"service-d-payment\"} | line_format `{\"level\":\"{{.severity_text}}\",\"msg\":\"{{__line__}}\",\"order_id\":\"{{.order_id}}\",\"payment_status\":\"{{.payment_status}}\",\"amount_cents\":\"{{.amount_cents}}\",\"http_status\":\"{{.http_status}}\",\"trace_id\":\"{{.trace_id}}\"}`"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Traces des paiements (cliquer sur un Trace ID)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "service-d-payment",
          "limit": 20,
          "operation": "POST /payments/charge"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "3. USE - est-ce que la machine tient ?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 301,
      "type": "timeseries",
      "title": "CPU du processus",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (process_cpu_state) (process_cpu_utilization{job=\"service-d-payment\"})",
          "legendFormat": "{{process_cpu_state}}"
        }
      ]
    },
    {
      "id": 302,
      "type": "timeseries",
      "title": "Mémoire du processus",
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_memory_usage{job=\"service-d-payment\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 303,
      "type": "timeseries",
      "title": "Saturation : retard boucle d'événements (p99)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_delay_p99{job=\"service-d-payment\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 304,
      "type": "timeseries",
      "title": "Utilisation de la boucle d'événements",
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_utilization{job=\"service-d-payment\"}",
          "legendFormat": "utilization"
        }
      ]
    }
  ]
}
