      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"service-a-auth\", route=\"/auth/login\", le=\"0.1\"}[7d])) / sum(rate(http_request_duration_seconds_count{job=\"service-a-auth\", route=\"/auth/login\"}[7d]))"
        }
      ]
    },
