      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{job=\"service-a-auth\", route=~\"/auth/login|/auth/verify\"}[5m])))",
          "legendFormat": "{{route}}"
        }
