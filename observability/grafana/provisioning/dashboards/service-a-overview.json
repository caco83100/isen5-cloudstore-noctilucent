            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"service-a-auth\", route=~\"/auth/login|/auth/verify\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taux de réponses 5xx",
      "description": "Les réponses 5xx indiquent une erreur serveur ; les refus 4xx sont suivis séparément.",
      "gridPos": {
        "x": 6,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"service-a-auth\", route=~\"/auth/login|/auth/verify\", status_code=~\"5..\"}[5m])) / sum by (route) (rate(http_requests_total{job=\"service-a-auth\", route=~\"/auth/login|/auth/verify\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Refus client 4xx par seconde",
      "description": "Suivi des requêtes rejetées, par route et code HTTP. Ces réponses ne consomment pas le budget de disponibilité.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 8
