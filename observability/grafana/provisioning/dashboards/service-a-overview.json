      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, status_code) (rate(http_requests_total{job=\"service-a-auth\", route=~\"/auth/login|/auth/verify\", status_code=~\"4..\"}[1m]))",
